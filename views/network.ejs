<%- include('partials/head') %><%- include('partials/nav') %><main class="single-column"><section class="panel"><h1>My Network</h1></section><section class="panel"><h2>Invitations</h2><% if (!incoming.length) { %><p class="muted">No pending invitations.</p><% } %><% incoming.forEach(user => { %><div class="person-row"><%- include('partials/avatar', { user, size:'medium' }) %><div class="grow"><a href="/profile/<%= user.id %>"><strong><%= user.name %></strong></a><span><%= [user.job_title, user.employer].filter(Boolean).join(' at ') || 'LeakedIn member' %></span></div><form method="post" action="/connections/<%= user.id %>/accept"><button class="primary">Accept</button></form><form method="post" action="/connections/<%= user.id %>/reject"><button class="secondary">Ignore</button></form></div><% }) %></section><section class="panel"><h2>Connections</h2><% connections.forEach(user => { %><a class="person-row" href="/profile/<%= user.id %>"><%- include('partials/avatar', { user, size:'medium' }) %><div><strong><%= user.name %></strong><span><%= [user.job_title, user.employer].filter(Boolean).join(' at ') || 'LeakedIn member' %></span></div></a><% }) %></section><section class="panel"><h2>Sent requests</h2><% outgoing.forEach(user => { %><a class="person-row" href="/profile/<%= user.id %>"><%- include('partials/avatar', { user, size:'medium' }) %><div><strong><%= user.name %></strong><span><%= [user.job_title, user.employer].filter(Boolean).join(' at ') || 'LeakedIn member' %></span></div></a><% }) %></section></main><%- include('partials/footer') %>
