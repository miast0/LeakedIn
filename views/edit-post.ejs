<%- include('partials/head') %><%- include('partials/nav') %><main class="form-page"><section class="panel"><h1>Edit post</h1><%- include('partials/flash') %><form method="post" action="/posts/<%= post.id %>/edit" enctype="multipart/form-data" class="stack"><textarea name="content" rows="8"><%= post.content || '' %></textarea><label>Replace image<input type="file" name="image" accept="image/png,image/jpeg"></label><label class="check"><input type="checkbox" name="is_private" <%= post.is_private ? 'checked' : '' %>> Private post</label><button class="primary">Save</button></form></section></main><%- include('partials/footer') %>
