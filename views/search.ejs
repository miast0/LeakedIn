<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="single-column">
  <section class="panel search-panel">
    <h1>Search people</h1>
    <form action="/search" class="search-page">
      <input name="q" value="<%= q %>" placeholder="Search by name, headline, employer or job title" aria-label="Search people">
      <button class="primary">Search</button>
    </form>
  </section>

  <% if (q && !users.length) { %>
    <section class="panel empty-state">
      <h2>No results found</h2>
      <p class="muted">Try a different name, employer, headline or job title.</p>
    </section>
  <% } %>

  <% users.forEach(user => { %>
    <a class="person-row" href="/profile/<%= user.id %>">
      <%- include('partials/avatar', { user, size: 'medium' }) %>
      <div>
        <strong><%= user.name %></strong>
        <span><%= user.headline || [user.job_title, user.employer].filter(Boolean).join(' at ') || 'LeakedIn member' %></span>
      </div>
    </a>
  <% }) %>
</main>

<%- include('partials/footer') %>
