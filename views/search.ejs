<%- include('partials/head') %><%- include('partials/nav') %><main class="single-column"><section class="panel"><h1>Search people</h1><form action="/search" class="search-page"><input name="q" value="<%= q %>" placeholder="Name, headline, employer or job title"><button class="primary">Search</button></form></section><% users.forEach(user => { %><a class="person-row" href="/profile/<%= user.id %>"><%- include('partials/avatar', { user, size: 'medium' }) %><div><strong><%= user.name %></strong><span><%= [user.job_title, user.employer].filter(Boolean).join(' at ') || 'LeakedIn member' %></span></div></a><% }) %></main><%- include('partials/footer') %>
