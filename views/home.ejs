<%- include('partials/head') %><%- include('partials/nav') %><main class="layout"><aside class="sidebar"><div class="profile-mini"><%- include('partials/avatar', { user: currentUser, size: 'large' }) %><a href="/profile/<%= currentUser.id %>"><strong><%= currentUser.name %></strong></a><span><%= [currentUser.job_title, currentUser.employer].filter(Boolean).join(' at ') || 'LeakedIn member' %></span></div></aside><section class="feed"><%- include('partials/flash') %><div class="composer"><div class="composer-row"><%- include('partials/avatar', { user: currentUser, size: 'medium' }) %><button id="openComposer" class="composer-trigger">Start a post</button></div><form id="composerForm" method="post" action="/posts" enctype="multipart/form-data" class="stack hidden"><textarea name="content" rows="5" placeholder="What do you want to talk about?"></textarea><label>Image <span class="hint">PNG or JPG, max 5 MB</span><input type="file" name="image" accept="image/png,image/jpeg"></label><label class="check"><input type="checkbox" name="is_private"> Private post, visible only to me</label><button class="primary">Post</button></form></div><div id="feed"></div><div id="feedStatus" class="feed-status">Loading posts...</div></section><aside class="rightbar"><div class="panel"><h3>LeakedIn News</h3><p>Oversharing remains the fastest-growing professional skill.</p></div></aside></main><script>window.currentUserAvatar = <%- JSON.stringify(currentUser.avatar_path || `/static/img/default-avatar-${Number(currentUser.avatar_variant || 0) % 5}.svg`) %>;</script><%- include('partials/footer') %>
