<%- include('partials/head') %><main class="auth-shell"><section class="auth-brand"><img src="/static/img/logo.svg"><h1>LeakedIn</h1></section><section class="auth-card wide"><h2>Create your account</h2><%- include('partials/flash') %><form method="post" action="/register" enctype="multipart/form-data" class="stack"><label>Name<input name="name" maxlength="120" required></label><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><label>Confirm password<input type="password" name="confirm_password" required></label><label>Profile photo <span class="hint">Optional, PNG or JPG, max 5 MB</span><input type="file" name="avatar" accept="image/png,image/jpeg"></label><label class="check"><input type="checkbox" name="show_email"> Show my email on my profile</label><button class="primary">Create account</button></form><a href="/login">Back to sign in</a></section></main><%- include('partials/footer') %>
